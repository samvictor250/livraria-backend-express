    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58687758",
    "_collection_link": "https://go.postman.co/collection/58687758-cf046b8a-d158-46de-9cda-7619a0bf25d5?source=collection_link"
  },
  "item": [
    {
      "name": "0. Status da API",
      "item": [
        {
          "name": "GET Status (requer login)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "A rota raiz está protegida pelo authMiddleware. Esperado: 200 com token válido; 401 sem token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Autenticação (Auth)",
      "item": [
        {
          "name": "POST Sign up - Cadastrar usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Pública. Cria usuário com role=user. O cadastro não retorna JWT; execute Login depois."
          },
          "response": []
        },
        {
          "name": "POST Login - Usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\n  const data = pm.response.json();\n  if (data.token) pm.environment.set('token', data.token);\n  if (data.user && data.user.role) pm.environment.set('loggedRole', data.user.role);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Pública. Salva automaticamente o JWT retornado em {{token}} para as próximas requisições."
          },
          "response": []
        },
        {
          "name": "POST Login - Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\n  const data = pm.response.json();\n  if (data.token) pm.environment.set('token', data.token);\n  if (data.user && data.user.role) pm.environment.set('loggedRole', data.user.role);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Use somente após configurar uma conta cujo role no banco seja admin. Salva o JWT em {{token}}."
          },
          "response": []
        },
        {
          "name": "POST Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\n  pm.environment.set('token', '');\n  pm.environment.set('loggedRole', '');\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Protegida. Revoga o token atual; após resposta 200, limpa a variável token."
          },
          "response": []
        }
      ],
      "description": "Somente register e login são públicos. Logout exige Bearer token."
    },
